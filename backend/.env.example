# Copy to .env (never commit .env). Node reads it with: node --env-file=.env src/server.ts
PORT=8787

# Which Care Intelligence provider answers POST /api/care.
# Phase 2-3: only "mock" exists. A real LLM provider is added in the next phase,
# behind the same CareIntelligenceProvider interface.
CARE_PROVIDER=mock

# Next phase only (not used yet). The key lives here on the server, never in the iOS app.
# ANTHROPIC_API_KEY=
