# Copy to .env (never commit .env). Node reads it with: node --env-file=.env src/server.ts
PORT=8787

# Which Care Intelligence provider answers POST /api/care: "mock" (no key) or "openai".
CARE_PROVIDER=mock

# OpenAI (CARE_PROVIDER=openai). The key lives here on the server, never in the iOS app.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# CARE_PROVIDER_TIMEOUT_MS=20000
